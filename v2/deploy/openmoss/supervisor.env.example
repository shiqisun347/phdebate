# Non-secret template. Copy to a protected host-only file and replace every REQUIRED value.
PHDEBATE_V2_ROOT=/opt/phdebate/v2
MOSS_SERVICE_USER=openmoss
MOSS_PROMPT_DIR=/opt/phdebate/moss-prompts
MOSS_UPSTREAM_CHECKOUT=/opt/OpenMOSS/MOSS-TTS
MOSS_MODEL_PATH=/opt/phdebate/models/MOSS-TTS-Realtime-6acbc7f161a0
MOSS_TOKENIZER_PATH=/opt/phdebate/models/MOSS-TTS-Realtime-6acbc7f161a0
MOSS_CODEC_MODEL_PATH=/opt/phdebate/models/MOSS-Audio-Tokenizer-3cd226ba2947
MOSS_RUN_DIR=/var/lib/phdebate/openmoss
MOSS_LOG_DIR=/var/log/phdebate/openmoss
MOSS_GPU_LOCK_DIR=/run/lock/phdebate-openmoss
MOSS_TELEMETRY_INTERVAL_SECONDS=5
OPENMOSS_DEPLOY_ENABLE=REQUIRED_EXPLICIT_ACK

MOSS_EP1_PORT=8890
MOSS_EP1_GPU_UUID=REQUIRED_GPU_UUID
MOSS_EP1_GPU_FINGERPRINT=REQUIRED_SHA256
MOSS_EP1_API_KEY_FILE=/run/secrets/openmoss-endpoint-1.key

MOSS_EP2_PORT=8891
MOSS_EP2_GPU_UUID=REQUIRED_GPU_UUID
MOSS_EP2_GPU_FINGERPRINT=REQUIRED_SHA256
MOSS_EP2_API_KEY_FILE=/run/secrets/openmoss-endpoint-2.key

MOSS_EP3_PORT=8892
MOSS_EP3_GPU_UUID=REQUIRED_GPU_UUID
MOSS_EP3_GPU_FINGERPRINT=REQUIRED_SHA256
MOSS_EP3_API_KEY_FILE=/run/secrets/openmoss-endpoint-3.key
