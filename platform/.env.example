APP_ENV=development
APP_SECRET=change-this-to-a-long-random-value
DATABASE_URL=sqlite:///./storage/phdebate.db
REDIS_URL=redis://127.0.0.1:6379/2
PUBLIC_ORIGIN=http://127.0.0.1:3200
COOKIE_SECURE=false

V2_ADMIN_ACCOUNT=admin
V2_ADMIN_REAL_NAME=系统管理员
V2_ADMIN_PASSWORD=change-this-admin-password

AGENT_API_URL=http://47.93.206.109:8000/api/debate
AGENT_MODEL_NAME=qwen3.6-27b
AGENT_TIMEOUT_SECONDS=120
AGENT_MOCK=false
JUDGE_API_URL=

FUNASR_WS_URL=ws://127.0.0.1:10095
REALTIME_VOICE_PIPELINE_ENABLED=false
REALTIME_VOICE_BACKEND=moss_realtime
# MOSS-only target. Keep disabled until every real endpoint passes the release gates.
MOSS_TTS_REALTIME_ENABLED=false
MOSS_TTS_REALTIME_TRANSPORT=websocket
MOSS_TTS_REALTIME_IDLE_WS_TTL_SECONDS=60
MOSS_TTS_REALTIME_URL=
MOSS_TTS_REALTIME_URLS=[]
MOSS_TTS_REALTIME_API_KEY=
MOSS_TTS_REALTIME_SPEECH_INSTRUCTION="请用自信、坚定、有说服力的中文辩论语气，语速比自然朗读快约百分之十，重音清晰，停顿简短，句尾有力，但不要喊叫或夸张。"
MOSS_TTS_PROMPT_FILES='{"debate_voice_1":"debate_voice_1.wav","debate_voice_2":"debate_voice_2.wav","debate_voice_3":"debate_voice_3.wav","debate_voice_4":"debate_voice_4.wav","debate_voice_5":"debate_voice_5.wav","debate_voice_6":"debate_voice_6.wav","debate_voice_7":"debate_voice_7.wav","debate_voice_8":"debate_voice_8.wav"}'
MOSS_TTS_REALTIME_MAX_ACTIVE=3
MOSS_TTS_REALTIME_MAX_ACTIVE_PER_ENDPOINT=1
MOSS_TTS_REALTIME_CONNECT_TIMEOUT_SECONDS=10
MOSS_TTS_REALTIME_ACK_TIMEOUT_SECONDS=30
MOSS_TTS_REALTIME_READINESS_TIMEOUT_SECONDS=2
MOSS_TTS_REALTIME_FIRST_PCM_TIMEOUT_SECONDS=1.2
MOSS_TTS_REALTIME_CLOSE_TIMEOUT_SECONDS=15
MOSS_TTS_REALTIME_JOB_TIMEOUT_SECONDS=240
# Formal Agent downlink. Keep disabled until real LiveKit + Chrome/Safari gates
# pass; websocket_pcm remains the explicit rollback transport.
WEBRTC_AUDIO_ENABLED=false
WEBRTC_AUDIO_BACKEND=websocket_pcm
LIVEKIT_URL=ws://127.0.0.1:7880
# Browsers receive this trusted public WSS endpoint. Empty falls back to the
# Engine URL, which is useful only for local development.
LIVEKIT_PUBLIC_URL=wss://rtc.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AUDIO_SAMPLE_RATE=48000
LIVEKIT_AUDIO_FRAME_MS=20
LIVEKIT_AUDIO_SOURCE_QUEUE_MS=200
LIVEKIT_AUDIO_MAX_BITRATE_BPS=64000
LIVEKIT_AUDIO_DTX_ENABLED=false
LIVEKIT_AUDIO_RED_ENABLED=true
LIVEKIT_AUDIO_APP_QUEUE_MS=2400
MOSS_TTS_LIVEKIT_START_BUFFER_MS=1200
LIVEKIT_CONNECT_TIMEOUT_SECONDS=5
LIVEKIT_TOKEN_TTL_SECONDS=300
LIVEKIT_PUBLISHER_TOKEN_TTL_SECONDS=600
MEDIA_ROOT=./storage/audio
ARCHIVE_ROOT=./storage/archives
BACKUP_STATUS_FILE=runtime/backup-status.json
BACKUP_MAX_AGE_HOURS=36
HEALTH_MIN_DISK_FREE_PERCENT=5
ENGINE_MAX_CONCURRENT_ROOMS=8
PRESENCE_RESET_ON_STARTUP=false
PRESENCE_LEASE_SECONDS=60
PRESENCE_REDIS_TIMEOUT_SECONDS=1

NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8200
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_WEBRTC_AUDIO_ENABLED=false
API_INTERNAL_ORIGIN=http://127.0.0.1:8200
# Shared only between the API token issuer and the private transcript
# collaboration service. Generate at least 32 random characters; never reuse
# APP_SECRET or expose this value to the browser.
TRANSCRIPT_COLLAB_HMAC_SECRET=
TRANSCRIPT_COLLAB_TOKEN_TTL_SECONDS=300
